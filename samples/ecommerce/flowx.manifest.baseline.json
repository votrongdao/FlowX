{
  "schemaVersion": "0.1.0",
  "application": {
    "name": "Ecommerce",
    "version": "1.0.0"
  },
  "flows": [
    {
      "id": "order.confirm",
      "version": "1.0.0",
      "profile": "Durable",
      "deadline": "PT30S",
      "input": {
        "type": "Ecommerce.PlaceOrder",
        "sensitive": [
          "PaymentToken"
        ]
      },
      "output": {
        "type": "Ecommerce.OrderPlacedResult"
      },
      "triggers": [
        {
          "kind": "Http",
          "method": "POST",
          "route": "/api/v1/confirmations",
          "idempotent": true
        }
      ],
      "steps": [
        {
          "id": 0,
          "kind": "Capability",
          "capability": "order.validate@1.0.0"
        },
        {
          "id": 1,
          "kind": "Emit",
          "event": "order.placed"
        }
      ],
      "emits": [
        "order.placed"
      ],
      "errors": [
        "order.invalid_quantity"
      ],
      "source": "ConfirmOrderFlow.cs:37"
    },
    {
      "id": "order.place",
      "version": "1.0.0",
      "profile": "Ephemeral",
      "deadline": "PT30S",
      "input": {
        "type": "Ecommerce.PlaceOrder",
        "sensitive": [
          "PaymentToken"
        ]
      },
      "output": {
        "type": "Ecommerce.OrderPlacedResult"
      },
      "triggers": [
        {
          "kind": "Agent",
          "description": "Place an order for a quantity of a stock-keeping unit and capture payment for it. Reserves inventory before charging, and releases the reservation if the charge fails.",
          "confirmation": "RequiredForSideEffects"
        },
        {
          "kind": "Http",
          "method": "POST",
          "route": "/api/v1/orders",
          "idempotent": true
        }
      ],
      "steps": [
        {
          "id": 0,
          "kind": "Capability",
          "capability": "order.validate@1.0.0"
        },
        {
          "id": 1,
          "kind": "Capability",
          "capability": "inventory.reserve@1.0.0",
          "compensation": "inventory.release@1.0.0"
        },
        {
          "id": 2,
          "kind": "Capability",
          "capability": "payment.capture@2.1.0"
        },
        {
          "id": 3,
          "kind": "Emit",
          "event": "order.placed"
        }
      ],
      "emits": [
        "order.placed"
      ],
      "errors": [
        "inventory.out_of_stock",
        "order.invalid_quantity",
        "payment.declined"
      ],
      "source": "PlaceOrderFlow.cs:73"
    },
    {
      "id": "order.project",
      "version": "1.0.0",
      "profile": "Durable",
      "deadline": "PT30S",
      "input": {
        "type": "FlowX.BusMessage"
      },
      "output": {
        "type": "Ecommerce.OrderProjection"
      },
      "triggers": [
        {
          "kind": "Change",
          "topic": "order.placed",
          "group": "projection"
        }
      ],
      "steps": [
        {
          "id": 0,
          "kind": "Capability",
          "capability": "order.project@1.0.0"
        }
      ],
      "emits": [],
      "errors": [
        "order.event_has_no_body"
      ],
      "source": "ProjectOrderFlow.cs:48"
    },
    {
      "id": "order.reprice",
      "version": "1.0.0",
      "profile": "Durable",
      "deadline": "PT30S",
      "input": {
        "type": "FlowX.BusMessage"
      },
      "output": {
        "type": "Ecommerce.RepricedOrder"
      },
      "triggers": [
        {
          "kind": "Bus",
          "topic": "order.placed",
          "group": "pricing"
        }
      ],
      "steps": [
        {
          "id": 0,
          "kind": "Capability",
          "capability": "order.reprice@1.0.0"
        }
      ],
      "emits": [],
      "errors": [
        "order.event_has_no_body"
      ],
      "source": "RepriceOrderFlow.cs:55"
    }
  ],
  "capabilities": [
    {
      "id": "inventory.release",
      "version": "1.0.0",
      "input": "Ecommerce.ValidatedOrder",
      "output": "Ecommerce.Reservation",
      "authorization": {
        "mode": "Internal"
      },
      "idempotent": true,
      "sideEffects": [
        "inventory-ledger"
      ],
      "errors": []
    },
    {
      "id": "inventory.reserve",
      "version": "1.0.0",
      "input": "Ecommerce.ValidatedOrder",
      "output": "Ecommerce.Reservation",
      "authorization": {
        "mode": "Authenticated"
      },
      "idempotent": true,
      "sideEffects": [
        "inventory-ledger"
      ],
      "errors": [
        {
          "code": "inventory.out_of_stock",
          "category": "Conflict"
        }
      ]
    },
    {
      "id": "order.project",
      "version": "1.0.0",
      "input": "FlowX.BusMessage",
      "output": "Ecommerce.OrderProjection",
      "authorization": {
        "mode": "Internal"
      },
      "idempotent": true,
      "sideEffects": [],
      "errors": [
        {
          "code": "order.event_has_no_body",
          "category": "Validation"
        }
      ]
    },
    {
      "id": "order.reprice",
      "version": "1.0.0",
      "input": "FlowX.BusMessage",
      "output": "Ecommerce.RepricedOrder",
      "authorization": {
        "mode": "Internal"
      },
      "idempotent": true,
      "sideEffects": [],
      "errors": [
        {
          "code": "order.event_has_no_body",
          "category": "Validation"
        }
      ]
    },
    {
      "id": "order.validate",
      "version": "1.0.0",
      "input": "Ecommerce.PlaceOrder",
      "output": "Ecommerce.ValidatedOrder",
      "authorization": {
        "mode": "Authenticated"
      },
      "idempotent": true,
      "sideEffects": [],
      "errors": [
        {
          "code": "order.invalid_quantity",
          "category": "Validation"
        }
      ]
    },
    {
      "id": "payment.capture",
      "version": "2.1.0",
      "input": "Ecommerce.Reservation",
      "output": "Ecommerce.Payment",
      "authorization": {
        "mode": "Permission",
        "value": "payment.write"
      },
      "idempotent": false,
      "sideEffects": [
        "ledger",
        "payment-gateway"
      ],
      "errors": [
        {
          "code": "payment.declined",
          "category": "Conflict"
        }
      ]
    }
  ],
  "events": [
    {
      "type": "order.placed",
      "schemaVersion": "1.0.0",
      "producedBy": [
        "order.confirm",
        "order.place"
      ]
    }
  ]
}

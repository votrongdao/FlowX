<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      netstandard2.0, not net10.0. Roslyn analyzers and source generators load into
      the compiler process, which runs on .NET Framework inside Visual Studio and on
      .NET Core inside `dotnet build`. netstandard2.0 is the only target that loads in
      both. This is a hard constraint, not a preference — a net10.0 generator silently
      does nothing in VS.

      The consequence worth understanding: this project CANNOT reference FlowX.Core.
      It emits source text that references FlowX.Core; it never links against it. So
      the model layer here is deliberately its own thing rather than a reuse of
      StepGraph and friends.
    -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>false</ImplicitUsings>

    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>

    <!--
      No symbols package, and this is not a style preference. Directory.Build.props sets
      IncludeSymbols repo-wide, which is right for every library that ships a lib/ folder.
      This project ships only an analyzer asset, so the .snupkg it would produce has no
      content at all, and pack fails it with NU5017 — after writing the .nupkg correctly,
      so the failure looks like a packaging bug rather than an empty-symbols one.

      It went unnoticed because nothing in this repository ran `dotnet pack` until a
      template needed a local feed to reference the platform the way a real consumer does.
      A build that cannot produce its own packages is a build nobody would discover was
      broken until the first release.
    -->
    <IncludeSymbols>false</IncludeSymbols>

    <Description>
      FlowX compile-time orchestration: analyzers and the source generator that turn a
      Define method into an ExecutionPlan and a step dispatcher.
    </Description>
    <PackageTags>flowx;roslyn;source-generator;analyzer</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Analyzers ship as an analyzer asset, not as a library reference. -->
    <DevelopmentDependency>true</DevelopmentDependency>
    <NoWarn>$(NoWarn);NU5128</NoWarn>

    <!-- netstandard2.0 has no trim/AOT story and needs none: this runs in the compiler. -->
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Pinned to the oldest Roslyn the generator must support, not the newest available.
      Referencing a newer API than the host compiler provides is the classic way to
      ship a generator that throws MissingMethodException on someone else's machine.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.6.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />

    <!-- Imported into any project that references the package. See the file's comment. -->
    <None Include="build/FlowX.Compiler.props" Pack="true" PackagePath="build" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Release tracking. RS2007/RS2008 refuse to build unless every diagnostic id is
      listed, which turns adding or changing a rule into a reviewable diff instead of
      something that shows up in someone's build one morning. A diagnostic id is part
      of the public surface (constraint C7) because teams write suppressions against it.
    -->
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

</Project>

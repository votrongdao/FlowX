<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <!-- Builds a real host, so startup validation is tested the way it actually fires. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/FlowX.Hosting/FlowX.Hosting.csproj" />

    <!--
      Durable execution end to end is exercised against the reference IFlowJournal and
      ILeaseStore rather than doubles written here. A second in-memory pair would be a pair
      nothing holds to the conformance suites, and the first thing it would drift on is the
      fencing check — the behaviour every guarantee in this package rests on. Referenced for
      its types; its own suites run in its own assembly.
    -->
    <ProjectReference Include="../FlowX.Conformance.Tests/FlowX.Conformance.Tests.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <!-- A real server, so the HTTP arm of the portability claim is asserted on the wire. -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The sample project itself, not a copy of it. If a flow's chain changes shape these
      tests fail, which is the only way the portability claim stays a claim about the
      sample rather than about a fixture written beside it.
    -->
    <ProjectReference Include="../../samples/event-driven/EventDriven.csproj" />

    <!-- FlowTestClock, so a cron occurrence can fall due without waiting until 03:00. -->
    <ProjectReference Include="../../src/FlowX.Testing/FlowX.Testing.csproj" />
  </ItemGroup>

</Project>

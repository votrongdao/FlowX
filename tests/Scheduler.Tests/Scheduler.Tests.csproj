<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Scheduler.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The sample project itself, not a copy of it. If the sample stops compiling, or its
      declaration changes shape, these fail — which is the only way a reference application
      stays a reference rather than becoming stale documentation.
    -->
    <ProjectReference Include="../../samples/scheduler/Scheduler.csproj" />

    <!--
      The host, because the sweep under test lives there and because a Durable flow needs
      one: FlowTestHost has no journal seam and refuses this flow before its first step.
    -->
    <ProjectReference Include="../../src/FlowX.Hosting/FlowX.Hosting.csproj" />

    <!--
      PostgreSQL, and not as an optional extra. Two of the claims this sample makes are
      about what a *store* refuses — one occurrence fires once however many nodes sweep,
      and an occurrence whose predecessor is still running is skipped — and both are
      settled by flow_instance's primary key and by an instance row's state. An in-memory
      double asserts those against code written for this test, which is the arrangement
      that makes a green suite mean nothing.
    -->
    <ProjectReference Include="../../plugins/FlowX.Postgres/FlowX.Postgres.csproj" />

    <!--
      FlowTestClock, and nothing else from it. Time is the one thing these tests simulate:
      a suite that waited an hour to see an hourly schedule fire twice would be testing
      the clock, and the sweep reads IClock exactly as it does in production.
    -->
    <ProjectReference Include="../../src/FlowX.Testing/FlowX.Testing.csproj" />
  </ItemGroup>

</Project>

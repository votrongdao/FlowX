<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copied so the CI fixture and the test that guards it stay in step. -->
    <None Include="fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/FlowX.Cli/FlowX.Cli.csproj" />

    <!--
      The replay tests write their rows through the real journal adapter rather than by
      hand, so an assertion about what `flowx replay` reads cannot pass against a row shape
      PostgresFlowJournal does not produce. ADR-0020 accepts that the CLI knows column names
      with no compiler check tying it to the migration that defines them; this reference is
      what makes the run-time check that replaces it faithful.

      It is a reference from a TEST project. FlowX.Cli itself still references no FlowX
      assembly, which is the whole of what CliLinksNoFlowXAssembly asserts.
    -->
    <ProjectReference Include="../../plugins/FlowX.Postgres/FlowX.Postgres.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <!-- A real server, so the sample's wire contract is asserted on the wire. -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!--
      References the sample project itself, not a copy of it. If the sample stops
      compiling or its flow changes shape, these tests fail — which is the only way a
      reference application stays a reference rather than becoming stale documentation.
    -->
    <ProjectReference Include="../../samples/ecommerce/Ecommerce.csproj" />

    <!--
      The test context the platform ships. If the sample's own tests do not use it, it
      is not worth shipping — that is WP-12's exit criterion, checked here.
    -->
    <ProjectReference Include="../../src/FlowX.Testing/FlowX.Testing.csproj" />

    <!--
      The two adapters the sample deliberately does not reference. samples/ecommerce is the
      repository's only NativeAOT-published assembly and CI publishes it (constraint C2), so it
      declares the flows, the contracts and the serialiser context and takes no broker or
      database package. EmitStartsAFlowTests supplies both and wires the chain the sample
      describes — which is the only place one flow's .Emit is seen starting another.
    -->
    <ProjectReference Include="../../plugins/FlowX.Postgres/FlowX.Postgres.csproj" />
    <ProjectReference Include="../../plugins/FlowX.Redis/FlowX.Redis.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.6.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="2.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.3" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <!-- Compiles the emitted source to prove it is valid C#, not merely plausible text. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <!--
      Validates the emitted manifest against the committed JSON Schema rather than
      against a hand-written list of field names. Structural assertions drift from the
      schema; this cannot.
    -->
    <PackageReference Include="JsonSchema.Net" Version="7.3.3" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Corpus/ is subject matter, not code. ErrorCatalogueCorpusTests parses it into
      compilations of its own and hands those to ErrorCatalogueReader, so it must not be
      compiled into this assembly: half of it deliberately does not resolve, one file
      belongs in a different assembly, and every specimen carries a [Capability] that
      would otherwise join the test assembly's own surface.

      Kept as .cs rather than as .txt on purpose. The corpus is the argument — a reader is
      meant to open these files and disagree with them — and that is much easier when an
      editor still treats them as C#.
    -->
    <Compile Remove="Corpus/**/*.cs" />
    <None Include="Corpus/**/*.cs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!--
      A plain reference, not an analyzer reference: these tests exercise the model and
      emitter as ordinary classes. Testing a generator only through the compiler is how
      generator test suites become slow and untrustworthy — the pure layers are tested
      as pure layers, and only the Roslyn plumbing needs a compilation.
    -->
    <ProjectReference Include="../../src/FlowX.Compiler/FlowX.Compiler.csproj" />
    <ProjectReference Include="../../src/FlowX.Runtime/FlowX.Runtime.csproj" />

    <!--
      For PolicyStageFitnessTests only: the compiler cannot reference the abstractions
      (netstandard2.0), so its copy of the stage ordering is pinned against the real one
      from here.
    -->
    <ProjectReference Include="../../src/FlowX.Abstractions/FlowX.Abstractions.csproj" />
  </ItemGroup>

</Project>

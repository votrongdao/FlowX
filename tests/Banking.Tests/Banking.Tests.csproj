<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <!-- A real server, so the sample's wire contract is asserted on the wire. -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The sample project itself, not a copy of it. If the sample stops compiling or its
      flow changes shape, these tests fail — which is the only way a reference application
      stays a reference rather than becoming stale documentation.
    -->
    <ProjectReference Include="../../samples/banking/Banking.csproj" />

    <!-- The test context the platform ships (WP-12). -->
    <ProjectReference Include="../../src/FlowX.Testing/FlowX.Testing.csproj" />

    <!--
      The conformance project, for its reference IFlowJournal and ILeaseStore.

      A durable flow needs a journal and a lease store to run at all, and the only shipped
      one is PostgreSQL. Driving these tests off a database would make the sample's own
      suite skip on a developer's machine — and docs/21-Quality-Gates.md §2.4 refuses a
      check that passes vacuously. The reference stores are public, are what
      ADR-0009 makes the semantic definition of a journal, and are the same objects
      FlowX.Postgres is held to; the redaction under test lives in JournalPayload and is
      therefore store-independent by construction. tests/FlowX.Postgres.Tests references
      this project the same way, from a different assembly.
    -->
    <ProjectReference Include="../FlowX.Conformance.Tests/FlowX.Conformance.Tests.csproj" />
  </ItemGroup>

</Project>

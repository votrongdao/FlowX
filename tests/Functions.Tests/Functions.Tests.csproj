<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Functions.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The sample project itself, not a copy of it — and here that reference carries more
      than usual: the generated entry points live in the sample's assembly, so these tests
      call the very methods a deployment would. If the generator emits something that does
      not compile, this project does not build.
    -->
    <ProjectReference Include="../../samples/functions/Functions.csproj" />

    <ProjectReference Include="../../src/FlowX.Hosting/FlowX.Hosting.csproj" />

    <!--
      PostgreSQL, and not as an optional extra. What a pushed message must produce is a
      journal row, and what a redelivery must produce is the same one — both are settled
      by flow_instance's primary key, and an in-memory double would assert them against
      code written for this test.
    -->
    <ProjectReference Include="../../plugins/FlowX.Postgres/FlowX.Postgres.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <!-- A real server, because the claim under test is an exchange on the wire. -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The sample project itself, not a copy of it. If the sample stops compiling or a flow
      changes shape, these fail — which is the only way a reference application stays a
      reference rather than becoming stale documentation.
    -->
    <ProjectReference Include="../../samples/ai-agent/AiAgent.csproj" />

    <!--
      The reviewer, referenced directly so its rules can be asserted against manifests the
      sample does not produce. The sample reaches it only through its own
      IApplicationReviewer, which is what FLOWX1003 requires of a capability; a test is not
      a capability and may hold it.
    -->
    <ProjectReference Include="../../src/FlowX.Ai/FlowX.Ai.csproj" />
  </ItemGroup>

</Project>

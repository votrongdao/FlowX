<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <!-- A real server, so tools/call is asserted on the wire and not against a handler. -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../plugins/FlowX.Mcp/FlowX.Mcp.csproj" />

    <!--
      The HTTP transport, so the refusal an agent receives and the refusal a request
      receives can be compared in one process against one flow. "The same stance the HTTP
      path enforces" is otherwise a claim about two code paths nobody ran together.
    -->
    <ProjectReference Include="../../plugins/FlowX.Http/FlowX.Http.csproj" />

    <ProjectReference Include="../../src/FlowX.Testing/FlowX.Testing.csproj" />

    <!--
      The compiler, as an ANALYZER. This project declares real flows with real
      [AgentTrigger] attributes, so the generator runs over them and this assembly carries
      a real FlowX.Generated.FlowXManifest and a real FlowXAgentTools.g.cs — the same two
      artifacts a consumer's build produces. A hand-written manifest string would test the
      projection against a document the compiler never wrote.
    -->
    <ProjectReference Include="../../src/FlowX.Compiler/FlowX.Compiler.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
